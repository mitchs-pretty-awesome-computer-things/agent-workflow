{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAW Configuration",
  "description": "Configuration for Mitch's Agent Workflow (MAW).",
  "$id": "https://raw.githubusercontent.com/mitchs-pretty-awesome-computer-things/agent-workflow/v0.5.0/maw.schema.json",
  "version": "0.5.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "URI of the MAW schema this config validates against."
    },
    "label_prefix": {
      "type": "string",
      "description": "Prefix used for GitHub labels created by the workflow.",
      "default": "maw",
      "minLength": 1
    },
    "overview_path": {
      "type": "string",
      "description": "Relative path where project overview/exploration documents are persisted.",
      "default": "docs/project-context"
    }
  },
  "additionalProperties": false,
  "required": ["label_prefix", "overview_path"]
}
